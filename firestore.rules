rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Commandes des convives à table (QR scan) & gestion cuisine/admin
    match /table_orders/{orderId} {
      allow read, write: if true;
    }

    // Appels de table (sommelier, eau/pain, serveur, addition)
    match /service_calls/{callId} {
      allow read, write: if true;
    }

    // Réservations de table
    match /reservations/{reservationId} {
      allow read, write: if true;
    }

    // Messages de contact
    match /contact_messages/{messageId} {
      allow read, write: if true;
    }

    // Candidatures recrutement
    match /job_applications/{applicationId} {
      allow read, write: if true;
    }
  }
}
